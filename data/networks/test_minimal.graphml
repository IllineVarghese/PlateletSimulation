<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <key id="weight" for="edge" attr.name="weight" attr.type="double"/>

  <graph id="G" edgedefault="directed">

    <node id="InCollisionImpulse"/>
    <node id="InShearStress"/>
    <node id="InMolecule"/>

    <node id="SignalA"/>
    <node id="SignalB"/>

    <node id="OutStickiness"/>
    <node id="OutSecretionRate"/>

    <edge source="InCollisionImpulse" target="SignalA">
      <data key="weight">1.0</data>
    </edge>

    <edge source="InShearStress" target="SignalA">
      <data key="weight">2.0</data>
    </edge>

    <edge source="InMolecule" target="SignalA">
      <data key="weight">1.5</data>
    </edge>

    <edge source="SignalA" target="SignalB">
      <data key="weight">1.5</data>
    </edge>

    <edge source="SignalB" target="OutStickiness">
      <data key="weight">1.5</data>
    </edge>

    <edge source="SignalB" target="OutSecretionRate">
      <data key="weight">1.2</data>
    </edge>

  </graph>
</graphml>